# Salin file ini menjadi .env lalu isi nilai-nilainya
# Token bot Telegram dari @BotFather
BOT_TOKEN=123456789:AA...your_token_here

# Mode jalan: "polling" (default, lokal) atau "webhook" (untuk deploy)
BOT_MODE=polling

# --- Hanya dipakai bila BOT_MODE=webhook ---
# URL publik HTTPS domain Anda (mis. https://gold.example.com)
WEBHOOK_URL=
WEBHOOK_PATH=telegram
WEBHOOK_PORT=8443

# (Opsional) perintah & argumen untuk menjalankan MCP server
# MCP_SERVER_CMD=
# MCP_SERVER_ARGS=gold_mcp_server.py

# (Opsional) ketahanan terhadap jaringan flaky
# BOT_BOOTSTRAP_RETRIES=10  # jumlah retry saat bot pertama connect ke Telegram
# BOT_MAX_RESTARTS=5        # restart otomatis polling bila error jaringan
# BOT_REQUEST_TIMEOUT=30    # timeout request ke Telegram (detik)

# (Opsional) cache TTL di MCP server (detik); 0 = nonaktifkan cache
# GOLD_PRICE_CACHE_TTL=30     # cache harga spot (hemat request, respons cepat)
# GOLD_HISTORY_CACHE_TTL=600  # cache histori harian untuk analisa/signal
# GOLD_INTRADAY_CACHE_TTL=180 # cache histori M15 untuk mode scalping
# GOLD_M5_CACHE_TTL=120       # cache histori M5 untuk trigger scalping cepat

# (Opsional) mode scalping momentum (/scalp, /scalping)
# GOLD_PIP_VALUE=1.0        # nilai 1 pip XAUUSD (default 1.0 poin = $1; broker
#                           # dengan kuotasi 2 desimal sering pakai 0.1)
# GOLD_SCALP_SL_PIPS=50     # stop loss tetap (pip)
# GOLD_SCALP_TP1_PIPS=100   # target utama (pip) -> R:R 1:2
# GOLD_SCALP_TP2_PIPS=150   # target runner (pip) -> R:R 1:3
# GOLD_SCALP_MIN_SCORE=4    # ambang skor confluence 0-6 (naikkan = lebih selektif)
# GOLD_SCALP_VALID_HOURS=4  # masa berlaku order limit sebelum kedaluwarsa (jam)

# (Opsional) mode scalping M5 (/m5, /scalp5) = trigger M5 + zona M15
# GOLD_SCALP_M5_SL_PIPS=5      # stop loss ketat mode M5 (pip) -> 5.00 poin bila GOLD_PIP_VALUE=1.0
# GOLD_SCALP_M5_TP1_PIPS=10    # target utama mode M5 (pip) -> R:R 1:2
# GOLD_SCALP_M5_TP2_PIPS=15    # target runner mode M5 (pip) -> R:R 1:3
# GOLD_SCALP_M5_MIN_SCORE=4    # ambang skor confluence 0-6
# GOLD_SCALP_M5_VALID_HOURS=1.5 # masa berlaku order limit M5 (jam, lebih pendek)

# (Opsional) bridge MCP
# MCP_PERSISTENT_SESSION=1  # 1 = sesi MCP dipakai ulang (cache hidup, cepat);
#                           # 0 = spawn MCP server baru tiap pesan
# MCP_CALL_TIMEOUT=120      # timeout satu panggilan tool MCP (detik)

# Catatan anti-konflik: bot menulis PID aktual ke bot.pid dan mengunci
# bot.lock selama hidup. Jangan jalankan dua instance sekaligus (penyebab
# error Telegram "terminated by other getUpdates"). Untuk stop:
# Stop-Process -Id (Get-Content bot.pid)