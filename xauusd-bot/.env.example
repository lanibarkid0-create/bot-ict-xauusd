# Salin menjadi .env untuk jalan lokal. Di Railway, isi lewat Variables.
BOT_TOKEN=123456789:AA...your_token_here

# polling = tidak butuh domain publik (dipakai di Railway) | webhook = butuh WEBHOOK_URL
BOT_MODE=polling

# --- Hanya untuk BOT_MODE=webhook ---
WEBHOOK_URL=
WEBHOOK_PATH=telegram
WEBHOOK_PORT=8443

# (Opsional) perintah menjalankan MCP server gold
# MCP_SERVER_ARGS=gold_mcp_server.py
